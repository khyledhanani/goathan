NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOYMENT=

# Convex Auth Google OAuth.
# Set these in Convex env because the OAuth exchange runs in Convex.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Cloudflare R2 proof media.
# Also set these in Convex env because the presigned upload action runs in Convex.
R2_BUCKET_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
